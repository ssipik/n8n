        "httpHeaderAuth": {
          "id": "3Pt5MnqtnCnHFmDf",
          "name": "Header Auth github"
        }
      }
    },
    {
      "parameters": {
        "language": "pythonNative",
        "pythonCode": "import json, re\n\nKEYWORDS = [\"breaking\", \"backward-incompatible\", \"backwards incompatible\",\n            \"migration\", \"deprecat\", \"removed\"]\n\ndef ver(tag):\n    t = tag.split(\"@\")[-1].lstrip(\"vV\")\n    if not re.fullmatch(r\"\\d+(\\.\\d+)*\", t):\n        return None\n    return tuple(int(x) for x in t.split(\".\"))\n\ndef pad(v, n=4):\n    return v + (0,) * (n - len(v))\n\ndef big_jump(cur, new):\n    if cur[0] >= 2000 or cur[0] == 0:      # calver (HA) or 0.x (AdGuard)\n        return pad(cur)[:2] != pad(new)[:2]\n    return cur[0] != new[0]\n\nsections, any_update = [], False\nunwatched = _items[0][\"json\"].get(\"unwatched\", []) if _items else []\n\nfor item in _items:\n    d = item[\"json\"]\n    app, cur_tag = d[\"app\"], d[\"current\"]\n    cur = ver(cur_tag) if cur_tag != \"NOT FOUND\" else None\n    if cur is None:\n        sections.append(f\"## {app}\\nCould not determine pinned version (got '{cur_tag}').\")\n        continue\n\n    newer = []\n    for r in json.loads(d[\"body\"]):\n        if r.get(\"draft\") or r.get(\"prerelease\"):\n            continue\n        v = ver(r[\"tag_name\"])\n        if v and pad(v) > pad(cur):\n            newer.append((v, r))\n    newer.sort(key=lambda x: pad(x[0]))\n\n    if not newer:\n        sections.append(f\"## {app}\\nPinned {cur_tag}: up to date.\")\n        continue\n\n    any_update = True\n    latest_v, latest = newer[-1]\n    hits = []\n    for v, r in newer:\n        found = [k for k in KEYWORDS if k in (r.get(\"body\") or \"\").lower()]\n        if found:\n            hits.append(f\"{r['tag_name']}: {', '.join(found)}\")\n    notes = \"\\n\\n\".join(\n        f\"### {r['tag_name']} ({r['html_url']})\\n{(r.get('body') or '')[:3000]}\"\n        for v, r in reversed(newer[-8:])\n    )\n    sections.append(\n        f\"## {app}\\nPinned: {cur_tag} | Latest: {latest['tag_name']} | Releases behind: {len(newer)}\\n\"\n        f\"Major/feature jump: {'YES' if big_jump(cur, latest_v) else 'no'}\\n\"\n        f\"Keyword hits: {'; '.join(hits) if hits else 'none'}\\n\\n{notes}\"\n    )\n\nif unwatched:\n    sections.append(\"## Not watched (no update-digest.repo label)\\n\" + \"\\n\".join(f\"- {u}\" for u in unwatched))\n\nreturn [{\"json\": {\"any_update\": any_update, \"report\": \"\\n\\n\".join(sections)}}]"
      },
