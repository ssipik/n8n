    {
      "parameters": {
        "language": "pythonNative",
        "pythonCode": "apps, unwatched, seen = [], [], set()\n\nfor item in _items:\n    c = item[\"json\"]\n    labels = c.get(\"Labels\") or {}\n    img = c.get(\"Image\", \"\")\n    name = labels.get(\"com.docker.compose.service\") or c[\"Names\"][0].lstrip(\"/\")\n    repo = labels.get(\"update-digest.repo\")\n\n    if not repo:\n        unwatched.append(f\"{name} ({img})\")\n        continue\n    if repo in seen:\n        continue\n    seen.add(repo)\n\n    tag = img.rsplit(\":\", 1)[1] if \":\" in img.rsplit(\"/\", 1)[-1] else \"NOT FOUND\"\n    apps.append({\n        \"app\": labels.get(\"update-digest.name\", name),\n        \"repo\": repo,\n        \"current\": tag,\n    })\n\nreturn [{\"json\": {**a, \"unwatched\": unwatched if i == 0 else []}} for i, a in enumerate(apps)]"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1104,
        -144
      ],
