      "name": "Merge"
    },
    {
      "parameters": {
        "language": "pythonNative",
        "pythonCode": "MISSING = \"container missing (removed or stack down)\"\n\n# Split the merged input: Docker containers vs. rows saved by the previous run\ncontainers = []\nprevious = {}\nfor item in _items:\n    row = item[\"json\"]\n    if \"Names\" in row:                  # came from the HTTP Request (Docker API)\n        containers.append(row)\n    elif row.get(\"name\"):               # came from the Data Table\n        previous[row[\"name\"]] = row\n\n# Evaluate every container's current state\ncurrent = {}\nignored = set()\nfor c in containers:\n    name = c[\"Names\"][0].lstrip(\"/\")\n    labels = c.get(\"Labels\") or {}\n    if labels.get(\"watchdog.ignore\") == \"true\":\n        ignored.add(name)\n        continue\n    state = c.get(\"State\", \"\")\n    if state == \"created\":\n        continue\n    project = labels.get(\"com.docker.compose.project\")\n    service = labels.get(\"com.docker.compose.service\")\n    label = f\"{project} / {service}\" if project else f\"(standalone) {name}\"\n\n    status = c.get(\"Status\", \"\")\n    health = (c.get(\"Health\") or {}).get(\"Status\")\n    problem = \"\"\n    if state == \"restarting\":\n        problem = \"restart loop\"\n    elif state in (\"exited\", \"dead\"):\n        if status.startswith(\"Exited (\"):\n            code = status[len(\"Exited (\"):status.index(\")\")]\n            problem = f\"{state} (exit code {code})\"\n        else:\n            problem = state\n    elif health == \"unhealthy\":\n        problem = \"unhealthy (healthcheck failing)\"\n    current[name] = {\"name\": name, \"label\": label, \"problem\": problem}\n\n# Compare with the previous run\nout = []\nlines = []\n\n# Containers that exist now\nfor name, now in current.items():\n    before = previous.get(name)\n    old_problem = (before.get(\"problem\") or \"\") if before else \"\"\n    old_label = (before.get(\"label\") or \"\") if before else \"\"\n    if before is None or old_problem != now[\"problem\"] or old_label != now[\"label\"]:\n        out.append({\"json\": {\"action\": \"save\", **now}})\n    if now[\"problem\"] and now[\"problem\"] != old_problem:\n        lines.append(f\"🔴 {now['label']}: {now['problem']}\")\n    elif not now[\"problem\"] and old_problem:\n        lines.append(f\"✅ {now['label']}: recovered\")\n\n# Containers we knew about that are gone now\nfor name, before in previous.items():\n    if name in current:\n        continue\n    if name in ignored:\n        # now carries watchdog.ignore -> forget it silently\n        out.append({\"json\": {\"action\": \"delete\", \"name\": name}})\n        continue\n    old_problem = before.get(\"problem\") or \"\"\n    if old_problem != MISSING:\n        # keep it in the table, marked as missing, so its return counts as recovery\n        label = before.get(\"label\") or name\n        out.append({\"json\": {\"action\": \"save\", \"name\": name, \"label\": label, \"problem\": MISSING}})\n        lines.append(f\"🔴 {label}: {MISSING}\")\n\nif lines:\n    text = \"🖥️ beelink container watchdog\\n\\n\" + \"\\n\".join(lines)\n    out.append({\"json\": {\"action\": \"notify\", \"text\": text}})\n\nreturn out"
      },
